<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        =====================================================================
        Módulo: sale_report_discount_display
        ─────────────────────────────────────────────────────────────────────
        ARQUITECTURA:

        La localización argentina usa l10n_ar_sale.report_saleorder_document
        (primary inherit de sale.report_saleorder_document) como template
        real del PDF. Dentro de ese template, el t-call al bloque de totales
        apunta a l10n_ar_sale.document_tax_totals (que ya tiene la lógica de
        discriminación de IVA vía doc.vat_discriminated).

        Nuestra estrategia: heredar l10n_ar_sale.document_tax_totals y
        reemplazar SOLO la fila <tr class="o_total"> con el bloque comercial.

        El bloque lee todo directamente desde `doc` (la sale.order), con la
        guarda doc._name == 'sale.order', porque este template también se
        renderiza en la vista del portal del cliente (donde no hay variables
        inyectadas por el caller) y potencialmente desde facturas
        (account.move, que no tiene estos campos).

        Así preservamos 100% la lógica de IVA de Argentina: el t-foreach
        de subtotales tiene t-if="doc.vat_discriminated" que ya controla
        si se discrimina el IVA (Responsable Inscripto) o no (Consumidor Final).
        =====================================================================
    -->

    <!--
        Reemplazar SOLO la fila "Total" en el template de totales
        ─────────────────────────────────────────────────────────────────────
        Heredamos l10n_ar_sale.document_tax_totals para reemplazar la fila
        <tr class="o_total"> con nuestro bloque comercial:

          1. Total sin descuento (tachado, gris, tipografía menor)
          2. Descuento aplicado con % (verde, tipografía menor)
          3. Total a pagar (destacado, fondo verde suave) — abajo de todo,
             la lectura cierra: tachado - descuento = total a pagar

        El resto del template (subtotals loop con t-if="doc.vat_discriminated"
        y el grupo de impuestos) queda INTACTO, por lo que la discriminación
        de IVA sigue funcionando exactamente como lo hace Odoo.
    -->
    <template
        id="document_tax_totals_discount_rows"
        inherit_id="l10n_ar_sale.document_tax_totals"
    >
        <!--
            Reemplazamos SOLO la fila <tr class="o_total"> (la línea de "Total").
            TODO LO DEMÁS queda intacto:
              - El t-foreach con t-if="doc.vat_discriminated" sigue controlando
                si se muestran los subtotales/impuestos según la responsabilidad AFIP.
              - La fila de redondeo (cash_rounding) también se preserva.
        -->
        <xpath expr="//tr[hasclass('o_total')]" position="replace">
            <t t-if="doc._name == 'sale.order' and doc.amount_discount_total &gt; 0.01">
                <!-- Separador visual: debajo va el detalle del descuento -->
                <tr>
                    <td colspan="2" class="pt-2 pb-0">
                        <hr class="mt-0 mb-0" style="border-color: #dee2e6;"/>
                    </td>
                </tr>

                <!-- Total SIN descuento (tachado, color gris, tipografía menor) -->
                <tr class="o_total_undiscounted" style="font-size: 0.9em;">
                    <td class="text-muted">
                        <span style="text-decoration: line-through;">Total sin descuento</span>
                    </td>
                    <td class="text-end text-muted">
                        <span
                            style="text-decoration: line-through;"
                            t-out="doc.amount_total_undiscounted"
                            t-options='{"widget": "monetary", "display_currency": currency}'
                        >0.00</span>
                    </td>
                </tr>

                <!-- Descuento aplicado con % (en verde, tipografía menor) -->
                <tr class="o_discount_total" style="font-size: 0.9em;">
                    <td style="color: #198754; font-weight: 600;">
                        <span>Descuento aplicado</span>
                        <t t-if="doc.discount_percent_label">
                            <span>(<t t-out="doc.discount_percent_label"/>%)</span>
                        </t>
                    </td>
                    <td class="text-end" style="color: #198754; font-weight: 600;">
                        <span
                            t-out="doc.amount_discount_total"
                            t-options='{"widget": "monetary", "display_currency": currency}'
                        >0.00</span>
                    </td>
                </tr>

                <!-- Total a pagar (negrita, fondo destacado): abajo de todo,
                     cierra la cuenta tachado - descuento = total a pagar -->
                <tr class="o_total">
                    <td style="background-color: #eaf6ee;">
                        <strong style="font-size: 1.1em;">Total a pagar</strong>
                    </td>
                    <td class="text-end" style="background-color: #eaf6ee;">
                        <strong
                            style="font-size: 1.1em;"
                            t-out="tax_totals['total_amount_currency']"
                            t-options='{"widget": "monetary", "display_currency": currency}'
                        >0.00</strong>
                    </td>
                </tr>
            </t>
            <t t-else="">
                <!-- Sin descuento (o no es un presupuesto): fila estándar de Odoo -->
                <tr class="o_total">
                    <td><strong>Total</strong></td>
                    <td class="text-end">
                        <strong
                            t-out="tax_totals['total_amount_currency']"
                            t-options='{"widget": "monetary", "display_currency": currency}'
                        >0.00</strong>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>
